From dfb8ee949f4386ec8f409e4101ba51bf1cdb8f13 Mon Sep 17 00:00:00 2001
From: devinizz <p17351988c@live.com>
Date: Sun, 22 Nov 2026 15:18:17 +0800
Subject: [PATCH 1/3] trade evolution by using space stone

---
 constants/item_constants.asm  | 2 +-
 data/items/key_items.asm      | 2 +-
 data/items/marts.asm          | 2 +-
 data/items/names.asm          | 2 +-
 data/items/prices.asm         | 2 +-
 data/items/use_party.asm      | 1 +
 engine/items/item_effects.asm | 2 +-
 engine/menus/party_menu.asm   | 6 +++++-
 engine/pokemon/evos_moves.asm | 8 +++++++-
 9 files changed, 19 insertions(+), 8 deletions(-)

diff --git a/constants/item_constants.asm b/constants/item_constants.asm
index 8f623d55..2847059f 100644
--- a/constants/item_constants.asm
+++ b/constants/item_constants.asm
@@ -53,7 +53,7 @@ DEF SAFARI_ROCK EQU CASCADEBADGE ; overload
 	const DOME_FOSSIL   ; $29
 	const HELIX_FOSSIL  ; $2A
 	const SECRET_KEY    ; $2B
-	const ITEM_2C       ; $2C ; unused
+	const SPACE_STONE   ; $2C
 	const BIKE_VOUCHER  ; $2D
 	const X_ACCURACY    ; $2E
 	const LEAF_STONE    ; $2F
diff --git a/data/items/key_items.asm b/data/items/key_items.asm
index 1750811f..c458f5a0 100644
--- a/data/items/key_items.asm
+++ b/data/items/key_items.asm
@@ -43,7 +43,7 @@ KeyItemFlags:
 	dbit TRUE  ; DOME_FOSSIL
 	dbit TRUE  ; HELIX_FOSSIL
 	dbit TRUE  ; SECRET_KEY
-	dbit TRUE  ; ITEM_2C
+	dbit FALSE ; SPACE_STONE
 	dbit TRUE  ; BIKE_VOUCHER
 	dbit FALSE ; X_ACCURACY
 	dbit FALSE ; LEAF_STONE
diff --git a/data/items/marts.asm b/data/items/marts.asm
index fbd0829a..6771c33e 100644
--- a/data/items/marts.asm
+++ b/data/items/marts.asm
@@ -26,7 +26,7 @@ CeladonMart2FClerk2Text::
 	script_mart TM_DOUBLE_TEAM, TM_REFLECT, TM_RAZOR_WIND, TM_HORN_DRILL, TM_EGG_BOMB, TM_MEGA_PUNCH, TM_MEGA_KICK, TM_TAKE_DOWN, TM_SUBMISSION
 
 CeladonMart4FClerkText::
-	script_mart POKE_DOLL, FIRE_STONE, THUNDER_STONE, WATER_STONE, LEAF_STONE
+	script_mart POKE_DOLL, FIRE_STONE, THUNDER_STONE, WATER_STONE, LEAF_STONE, SPACE_STONE
 
 CeladonMart5FClerk1Text::
 	script_mart X_ACCURACY, GUARD_SPEC, DIRE_HIT, X_ATTACK, X_DEFEND, X_SPEED, X_SPECIAL
diff --git a/data/items/names.asm b/data/items/names.asm
index f5c0f27e..b7932834 100644
--- a/data/items/names.asm
+++ b/data/items/names.asm
@@ -43,7 +43,7 @@ ItemNames::
 	li "DOME FOSSIL"
 	li "HELIX FOSSIL"
 	li "SECRET KEY"
-	li "?????" ; ITEM_2C
+	li "SPACE STONE"
 	li "BIKE VOUCHER"
 	li "X ACCURACY"
 	li "LEAF STONE"
diff --git a/data/items/prices.asm b/data/items/prices.asm
index aefd1078..c11ba412 100644
--- a/data/items/prices.asm
+++ b/data/items/prices.asm
@@ -43,7 +43,7 @@ ItemPrices::
 	bcd3 0     ; DOME_FOSSIL
 	bcd3 0     ; HELIX_FOSSIL
 	bcd3 0     ; SECRET_KEY
-	bcd3 0     ; ITEM_2C
+	bcd3 2100  ; SPACE_STONE
 	bcd3 0     ; BIKE_VOUCHER
 	bcd3 950   ; X_ACCURACY
 	bcd3 2100  ; LEAF_STONE
diff --git a/data/items/use_party.asm b/data/items/use_party.asm
index e8da68be..560bd49e 100644
--- a/data/items/use_party.asm
+++ b/data/items/use_party.asm
@@ -20,6 +20,7 @@ UsableItems_PartyMenu:
 	db CARBOS
 	db CALCIUM
 	db RARE_CANDY
+	db SPACE_STONE
 	db LEAF_STONE
 	db FULL_HEAL
 	db REVIVE
diff --git a/engine/items/item_effects.asm b/engine/items/item_effects.asm
index c4ce13de..9eab003f 100644
--- a/engine/items/item_effects.asm
+++ b/engine/items/item_effects.asm
@@ -60,7 +60,7 @@ ItemUsePtrTable:
 	dw UnusableItem      ; DOME_FOSSIL
 	dw UnusableItem      ; HELIX_FOSSIL
 	dw UnusableItem      ; SECRET_KEY
-	dw UnusableItem      ; ITEM_2C
+	dw ItemUseEvoStone   ; SPACE_STONE
 	dw UnusableItem      ; BIKE_VOUCHER
 	dw ItemUseXAccuracy  ; X_ACCURACY
 	dw ItemUseEvoStone   ; LEAF_STONE
diff --git a/engine/menus/party_menu.asm b/engine/menus/party_menu.asm
index 2a308642..1e861f19 100644
--- a/engine/menus/party_menu.asm
+++ b/engine/menus/party_menu.asm
@@ -140,6 +140,9 @@ RedrawPartyMenu_::
 	ld a, [hli]
 	and a ; reached terminator?
 	jr z, .placeEvolutionStoneString ; if so, place the "NOT ABLE" string
+	ld b, SPACE_STONE
+	cp EVOLVE_TRADE
+	jr z, .checkStoneItem
 	inc hl
 	inc hl
 	cp EVOLVE_ITEM
@@ -148,8 +151,9 @@ RedrawPartyMenu_::
 	dec hl
 	dec hl
 	ld b, [hl]
-	ld a, [wEvoStoneItemID] ; the stone the player used
 	inc hl
+.checkStoneItem
+	ld a, [wEvoStoneItemID] ; the stone the player used
 	inc hl
 	inc hl
 	cp b ; does the player's stone match this evolution entry's stone?
diff --git a/engine/pokemon/evos_moves.asm b/engine/pokemon/evos_moves.asm
index 94566db4..c3d9a544 100644
--- a/engine/pokemon/evos_moves.asm
+++ b/engine/pokemon/evos_moves.asm
@@ -85,13 +85,19 @@ Evolution_PartyMonLoop: ; loop over party mons
 .checkTradeEvo
 	ld a, [wLinkState]
 	cp LINK_STATE_TRADING
-	jp nz, .nextEvoEntry1 ; if not trading, go to the next evolution entry
+	jp nz, .checkSpaceStone ; if not trading, check if using space stone
+.continueTrade
 	ld a, [hli] ; level requirement
 	ld b, a
 	ld a, [wLoadedMonLevel]
 	cp b ; is the mon's level greater than the evolution requirement?
 	jp c, Evolution_PartyMonLoop ; if so, go the next mon
 	jr .doEvolution
+.checkSpaceStone
+	ld a, [wCurItem] ; this is supposed to be the last item used, but it is also used to hold species numbers
+	cp SPACE_STONE
+	jp nz, .nextEvoEntry1 ; if not, go to the next evolution entry
+	jr .continueTrade
 .checkItemEvo
 	ld a, [hli]
 	; Bug: Wild encounters can cause stone evolutions without
