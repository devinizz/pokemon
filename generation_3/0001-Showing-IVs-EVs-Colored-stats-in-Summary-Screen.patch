diff --git a/src/pokemon_summary_screen.c b/src/pokemon_summary_screen.c
index 96407787b..bdf632dfe 100644
--- a/src/pokemon_summary_screen.c
+++ b/src/pokemon_summary_screen.c
@@ -186,6 +186,7 @@ static EWRAM_DATA struct PokemonSummaryScreenData
     bool8 handleDeoxys;
     s16 switchCounter; // Used for various switch statement cases that decompress/load graphics or Pokémon data
     u8 unk_filler4[6];
+    u8 stat_mode;
 } *sMonSummaryScreen = NULL;
 EWRAM_DATA u8 gLastViewedMonIndex = 0;
 static EWRAM_DATA u8 sMoveSlotToReplace = 0;
@@ -271,6 +272,7 @@ static void Task_PrintSkillsPage(u8);
 static void PrintHeldItemName(void);
 static void PrintSkillsPageText(void);
 static void PrintRibbonCount(void);
+static u8 *ColorStatByNature(u8 *dest, s8 natureMod);
 static void BufferLeftColumnStats(void);
 static void PrintLeftColumnStats(void);
 static void BufferRightColumnStats(void);
@@ -1572,6 +1574,28 @@ static void Task_HandleInput(u8 taskId)
             PlaySE(SE_SELECT);
             BeginCloseSummaryScreen(taskId);
         }
+        else if (JOY_NEW(L_BUTTON))
+        {
+            if (sMonSummaryScreen->currPageIndex == PSS_PAGE_SKILLS)
+            {
+                if (sMonSummaryScreen->stat_mode > 0)
+                {
+                    sMonSummaryScreen->stat_mode--;
+                    PrintPageSpecificText(PSS_PAGE_SKILLS);
+                }
+            }
+        }
+        else if (JOY_NEW(R_BUTTON))
+        {
+            if (sMonSummaryScreen->currPageIndex == PSS_PAGE_SKILLS)
+            {
+                if (sMonSummaryScreen->stat_mode < 2)
+                {
+                    sMonSummaryScreen->stat_mode++;
+                    PrintPageSpecificText(PSS_PAGE_SKILLS);
+                }
+            }
+        }
     }
 }
 
@@ -3388,17 +3412,58 @@ static void PrintRibbonCount(void)
     PrintTextOnWindow(AddWindowFromTemplateList(sPageSkillsTemplate, PSS_DATA_WINDOW_SKILLS_RIBBON_COUNT), text, x, 1, 0, 0);
 }
 
+static u8 *ColorStatByNature(u8 *dest, s8 natureMod)
+{
+    static const u8 colorDown[] = _("{COLOR LIGHT_RED}");
+    static const u8 colorUp[] = _("{COLOR BLUE}");
+    static const u8 colorNeutral[] = _("{COLOR WHITE}");
+    switch (natureMod)
+    {
+        case 1:
+            return StringCopy(dest, colorUp);
+        case -1:
+            return StringCopy(dest, colorDown);
+        default:
+            return StringCopy(dest, colorNeutral);
+    }
+}
 static void BufferLeftColumnStats(void)
 {
     u8 *currentHPString = Alloc(8);
     u8 *maxHPString = Alloc(8);
-    u8 *attackString = Alloc(8);
-    u8 *defenseString = Alloc(8);
+    u8 *attackString = Alloc(32);
+    u8 *defenseString = Alloc(32);
+
+    static const u8 iv[] = _(" IV "),  ev[] = _(" EV ");
+    u16 hp, atk, def;
+    struct Pokemon *mon = &sMonSummaryScreen->currentMon;
+    const s8 *natureMod = gNatureStatTable[NATURE_HARDY]; //no color
+    switch (sMonSummaryScreen->stat_mode)
+    {
+        case 0:
+            natureMod = gNatureStatTable[sMonSummaryScreen->summary.nature];
+            hp = sMonSummaryScreen->summary.maxHP;
+            atk = sMonSummaryScreen->summary.atk;
+            def = sMonSummaryScreen->summary.def;
+            ConvertIntToDecimalStringN(currentHPString, sMonSummaryScreen->summary.currentHP, STR_CONV_MODE_RIGHT_ALIGN, 3);
+            break;
+        case 1:
+            hp = GetMonData(mon, MON_DATA_HP_IV);
+            atk = GetMonData(mon, MON_DATA_ATK_IV);
+            def = GetMonData(mon, MON_DATA_DEF_IV);
+            StringCopy(currentHPString, iv);
+            break;
+        case 2:
+            hp = GetMonData(mon, MON_DATA_HP_EV);
+            atk = GetMonData(mon, MON_DATA_ATK_EV);
+            def = GetMonData(mon, MON_DATA_DEF_EV);
+            StringCopy(currentHPString, ev);
+            break;
+    }
 
-    ConvertIntToDecimalStringN(currentHPString, sMonSummaryScreen->summary.currentHP, STR_CONV_MODE_RIGHT_ALIGN, 3);
-    ConvertIntToDecimalStringN(maxHPString, sMonSummaryScreen->summary.maxHP, STR_CONV_MODE_RIGHT_ALIGN, 3);
-    ConvertIntToDecimalStringN(attackString, sMonSummaryScreen->summary.atk, STR_CONV_MODE_RIGHT_ALIGN, 7);
-    ConvertIntToDecimalStringN(defenseString, sMonSummaryScreen->summary.def, STR_CONV_MODE_RIGHT_ALIGN, 7);
+    ConvertIntToDecimalStringN(maxHPString, hp, STR_CONV_MODE_RIGHT_ALIGN, 3);
+    ConvertIntToDecimalStringN(ColorStatByNature(attackString, natureMod[STAT_ATK - 1]), atk, STR_CONV_MODE_RIGHT_ALIGN, 7);
+    ConvertIntToDecimalStringN(ColorStatByNature(defenseString, natureMod[STAT_DEF - 1]), def, STR_CONV_MODE_RIGHT_ALIGN, 7);
 
     DynamicPlaceholderTextUtil_Reset();
     DynamicPlaceholderTextUtil_SetPlaceholderPtr(0, currentHPString);
@@ -3420,9 +3485,31 @@ static void PrintLeftColumnStats(void)
 
